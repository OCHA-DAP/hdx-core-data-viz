# HAPI API tracking identifier (not auth — used to identify your app in request logs)
EMAIL=you@example.com
APP_NAME=hdx-hapi-cloud-native

# Source Cooperative upload
# Set SOURCE_COOP_PREFIX to "<org>/<product>" to target your dataset, e.g. ocha-dap/hdx-hapi
SOURCE_COOP_PREFIX=
# Set SOURCE_COOP_UPLOAD=1 to sync output/ at the end of each pipeline run
SOURCE_COOP_UPLOAD=

# AWS credentials — obtain temporary credentials from your Source Cooperative product page
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
