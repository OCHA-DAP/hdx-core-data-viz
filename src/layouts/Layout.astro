---
interface Props {
  title?: string;
}

const { title = "HDX" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pathname = Astro.url.pathname;

const navLinks = [
  { href: base, label: "Explorer" },
  { href: `${base}food-security`, label: "Food Security" },
  { href: `${base}refugees`, label: "Refugee Flows" },
  { href: `${base}timeline`, label: "Crisis Timeline" },
  { href: `${base}food-prices`, label: "Food Prices" },
  { href: `${base}availability`, label: "Availability" },
  { href: `${base}about`, label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #f5f7fa;
        --text: #1a1a1a;
        --text-muted: #666;
        --text-sep: #bbb;
        --hover-bg: rgba(0, 0, 0, 0.06);
        --spinner-track: rgba(0, 0, 0, 0.1);
        --error-text: #c0392b;
      }
      :root[data-theme="dark"] {
        --bg: #0f1117;
        --text: #e0e0e0;
        --text-muted: #888;
        --text-sep: #555;
        --hover-bg: rgba(255, 255, 255, 0.08);
        --spinner-track: rgba(255, 255, 255, 0.1);
        --error-text: #f46d43;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100dvh;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, sans-serif;
        transition: background 0.2s;
        display: flex;
        flex-direction: column;
      }
      nav {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 16px;
        height: 40px;
        border-bottom: 1px solid var(--text-sep);
        background: var(--bg);
      }
      .nav-wordmark {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.03em;
        color: var(--text);
        margin-right: 24px;
        white-space: nowrap;
        user-select: none;
      }
      .nav-links {
        display: flex;
        align-items: stretch;
        height: 100%;
        gap: 0;
      }
      .nav-links a {
        display: flex;
        align-items: center;
        padding: 0 12px;
        font-size: 13px;
        text-decoration: none;
        color: var(--text-muted);
        border-bottom: 2px solid transparent;
        transition: color 0.15s, background 0.15s;
        white-space: nowrap;
      }
      .nav-links a:hover {
        color: var(--text);
        background: var(--hover-bg);
      }
      .nav-links a.active {
        color: var(--text);
        font-weight: 600;
        border-bottom-color: var(--text);
      }
      main {
        flex: 1;
        min-height: 0;
        overflow: hidden;
      }
    </style>
  <script is:inline>
    (function () {
      var t = localStorage.getItem("theme");
      if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
    })();
  </script>
  </head>
  <body>
    <nav>
      <span class="nav-wordmark">HDX Core Data</span>
      <div class="nav-links">
        {navLinks.map(({ href, label }) => (
          <a href={href} class={pathname.replace(/\/$/, "") === href.replace(/\/$/, "") ? "active" : ""}>
            {label}
          </a>
        ))}
      </div>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
