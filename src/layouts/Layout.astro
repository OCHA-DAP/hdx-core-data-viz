---
interface Props {
  title?: string;
}

const { title = "HDX" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #f5f7fa;
        --text: #1a1a1a;
        --text-muted: #666;
        --text-sep: #bbb;
        --hover-bg: rgba(0, 0, 0, 0.06);
        --spinner-track: rgba(0, 0, 0, 0.1);
        --error-text: #c0392b;
      }
      :root[data-theme="dark"] {
        --bg: #0f1117;
        --text: #e0e0e0;
        --text-muted: #888;
        --text-sep: #555;
        --hover-bg: rgba(255, 255, 255, 0.08);
        --spinner-track: rgba(255, 255, 255, 0.1);
        --error-text: #f46d43;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100dvh;
        overflow: hidden;
        background: var(--bg);
        font-family: system-ui, sans-serif;
        transition: background 0.2s;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
