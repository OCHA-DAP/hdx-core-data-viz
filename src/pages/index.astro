---
import Layout from "../layouts/Layout.astro";
import { LENSES, COMING_SOON } from "../lib/hapi/lenses";
import { DOMAIN_COLORS, DOMAIN_LABELS, DATASET_LIST } from "../lib/hapi/datasets";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout>
  <!-- Hero -->
  <header class="hero">
    <div class="hero-text">
      <h1>
        HDX <span class="accent">Lens</span>
      </h1>
      <p class="tagline">
        Explore humanitarian data across 10 HAPI datasets. Ask complex, multi-dimensional questions.
        No downloads. No data engineering. Everything runs in your browser.
      </p>
      <a href={`${base}/explore`} class="cta-btn">Open Explorer →</a>
    </div>
    <div class="hero-stats">
      {
        [
          { n: "10", label: "Datasets" },
          { n: "12+", label: "Domain fields" },
          { n: "249", label: "Countries" },
          { n: "0", label: "Server calls" },
        ].map((s) => (
          <div class="stat">
            <span class="stat-n">{s.n}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </header>

  <!-- Available lenses -->
  <section class="section-block">
    <h2>Available Now — HAPI Data Lenses</h2>
    <p class="section-sub">
      Pre-built analytical views across the five Core Data Model use cases, powered by live HAPI
      data.
    </p>
    <div class="lens-grid">
      {
        LENSES.map((lens) => (
          <a href={`${base}/explore?lens=${lens.id}`} class="lens-card">
            <div class="lens-card-icon">{lens.icon}</div>
            <div class="lens-card-body">
              <div class="lens-card-title">{lens.title}</div>
              <div class="lens-card-desc">{lens.description}</div>
            </div>
            <div class="uc-tag">{lens.useCase}</div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Dataset reference -->
  <section class="section-block">
    <h2>HAPI Datasets Included</h2>
    <p class="section-sub">
      All data is read directly from cloud-native Parquet files at
      <a href="https://data.source.coop/hdx/hapi/collection.json" target="_blank" rel="noopener"
        >data.source.coop</a
      > via HTTP range requests — only the columns and row groups you query are fetched.
    </p>
    <div class="dataset-grid">
      {
        DATASET_LIST.map((ds) => (
          <div class="dataset-row">
            <span
              class="domain-dot"
              style={`background:${DOMAIN_COLORS[ds.domain]}`}
            />
            <div class="dataset-info">
              <span class="dataset-name">{ds.label}</span>
              <span class="dataset-domain">{DOMAIN_LABELS[ds.domain]}</span>
            </div>
            <span class="dataset-desc-sm">{ds.description}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Coming soon -->
  <section class="section-block coming-soon-section">
    <h2>Coming Soon — Future Core Data Domains</h2>
    <p class="section-sub">
      As the Core Data Model expands beyond HAPI, these domains will be queryable through the same
      interface — joining across them without any custom data engineering.
    </p>
    <div class="lens-grid">
      {
        COMING_SOON.map((item) => (
          <div class="lens-card disabled">
            <div class="lens-card-icon">{item.icon}</div>
            <div class="lens-card-body">
              <div class="lens-card-title">{item.title}</div>
              <div class="lens-card-desc">{item.description}</div>
              <div class="example-q">
                <span class="eq-label">Example question:</span>
                {item.exampleQuestion}
              </div>
            </div>
            <div class="soon-tag">Soon</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- How it works -->
  <section class="section-block">
    <h2>How It Works</h2>
    <div class="how-grid">
      {
        [
          {
            step: "1",
            title: "DuckDB-WASM loads in your browser",
            body: "A full SQL engine (DuckDB) compiled to WebAssembly initialises client-side — no server involved.",
          },
          {
            step: "2",
            title: "HTTP range reads against Parquet",
            body: "DuckDB fetches only the column chunks it needs from remote Parquet files at data.source.coop, using predicate pushdown.",
          },
          {
            step: "3",
            title: "SQL + Vega-Lite render results",
            body: "Generated SQL runs in-browser; results render as interactive tables and Vega-Lite charts — all client-side.",
          },
        ].map((s) => (
          <div class="how-step">
            <div class="step-num">{s.step}</div>
            <div>
              <div class="step-title">{s.title}</div>
              <div class="step-body">{s.body}</div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    background: #fff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 2rem 2rem 1.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-text {
    flex: 1;
    min-width: 280px;
  }

  h1 {
    font-size: 36px;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: #1a1a1a;
  }

  .accent {
    color: #007ce0;
  }

  .tagline {
    font-size: 15px;
    color: #555;
    margin: 0 0 1.25rem;
    max-width: 520px;
    line-height: 1.6;
  }

  .cta-btn {
    display: inline-block;
    background: #007ce0;
    color: #fff;
    text-decoration: none;
    padding: 0.55rem 1.25rem;
    border-radius: 3px;
    font-weight: 600;
    font-size: 14px;
  }

  .cta-btn:hover {
    background: #005fac;
    color: #fff;
  }

  .hero-stats {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 0.5rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 56px;
  }

  .stat-n {
    font-size: 28px;
    font-weight: 700;
    color: #007ce0;
    line-height: 1;
  }

  .stat-label {
    font-size: 11px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  /* ── Lens grid ────────────────────────────────────────────── */
  .lens-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
  }

  .lens-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid #cccccc;
    border-radius: 5px;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: border-color 0.12s, box-shadow 0.12s;
    background: #fff;
  }

  .lens-card:hover:not(.disabled) {
    border-color: #007ce0;
    box-shadow: 0 2px 10px rgba(0, 124, 224, 0.1);
  }

  .lens-card.disabled {
    background: #fafafa;
    color: #aaa;
    cursor: default;
  }

  .lens-card-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .lens-card-title {
    font-weight: 700;
    font-size: 13px;
    color: #222;
    margin-bottom: 0.2rem;
  }

  .lens-card.disabled .lens-card-title {
    color: #999;
  }

  .lens-card-desc {
    font-size: 12px;
    color: #666;
    line-height: 1.45;
  }

  .lens-card.disabled .lens-card-desc {
    color: #bbb;
  }

  .uc-tag {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 700;
    color: #007ce0;
    background: #e8f4ff;
    border: 1px solid #b8d8f8;
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }

  .soon-tag {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 700;
    color: #aaa;
    background: #f0f0f0;
    border: 1px solid #ddd;
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }

  .example-q {
    font-size: 11px;
    color: #bbb;
    font-style: italic;
    margin-top: 0.5rem;
    line-height: 1.4;
  }

  .eq-label {
    font-style: normal;
    font-weight: 600;
    display: block;
    margin-bottom: 0.1rem;
  }

  /* ── Dataset reference grid ───────────────────────────────── */
  .dataset-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
    overflow: hidden;
  }

  .dataset-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid #e0e0e0;
    font-size: 13px;
  }

  .dataset-row:last-child {
    border-bottom: none;
  }

  .dataset-row:hover {
    background: #f9f9f9;
  }

  .domain-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.35rem;
  }

  .dataset-info {
    flex-shrink: 0;
    width: 220px;
  }

  .dataset-name {
    font-weight: 600;
    display: block;
    color: #222;
  }

  .dataset-domain {
    font-size: 11px;
    color: #888;
  }

  .dataset-desc-sm {
    font-size: 12px;
    color: #888;
  }

  /* ── How it works ─────────────────────────────────────────── */
  .how-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .how-step {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #007ce0;
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-title {
    font-weight: 700;
    font-size: 13px;
    margin-bottom: 0.25rem;
  }

  .step-body {
    font-size: 12px;
    color: #666;
    line-height: 1.5;
  }

  /* ── Coming soon tint ─────────────────────────────────────── */
  .coming-soon-section h2 {
    color: #888 !important;
  }
</style>
